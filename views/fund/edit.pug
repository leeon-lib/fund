extends ../layout
block content
    div.panel-heading
        h4.panel-title 编辑基金
    div.panel-body
        form(action="/funds/" + fund._id + "/update" method="POST")
            div.form-group
                label 基金名称 *
                input.form-control(type="text" name="name" value=fund.name required)
            div.form-group
                label 基金代码
                input.form-control(type="text" name="code" value=fund.code || '')
            div.form-group
                label 持有份额
                input.form-control(type="number" name="amount" step="0.01" value=fund.amount)
            div.form-group
                label 买入价格
                input.form-control(type="number" name="buy_price" step="0.0001" value=fund.buy_price)
            div.form-group
                label 当前价格
                input.form-control(type="number" name="current_price" step="0.0001" value=fund.current_price)
            div.form-group
                label 购买日期
                input.form-control(type="date" name="buy_date")
            div.form-group
                label 备注
                textarea.form-control(name="note" rows="3")= fund.note || ''
            button.btn.btn-primary(type="submit") 更新
            |  
            a.btn.btn-default(href="/funds") 取消
