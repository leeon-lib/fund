extends ../layout
block content
    div.panel-heading
        h4.panel-title 编辑资料
    div.panel-body
        form(action="/profile/update" method="POST")
            div.form-group
                label 邮箱
                input.form-control(type="text" value=user.email disabled)
            div.form-group
                label 姓名
                input.form-control(type="text" name="name" value=user.name || '' placeholder="请输入姓名")
            button.btn.btn-primary(type="submit") 保存
            |  
            a.btn.btn-default(href="/profile") 取消
