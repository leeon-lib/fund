extends ../layout
block content
    div.panel-heading
        h4.panel-title 修改密码
    div.panel-body
        if error_msg
            div.alert.alert-danger= error_msg
        if success_msg
            div.alert.alert-success= success_msg
        form(action="/profile/password" method="POST")
            div.form-group
                label 原密码 *
                input.form-control(type="password" name="old_password" placeholder="请输入原密码" required)
            div.form-group
                label 新密码 *
                input.form-control(type="password" name="new_password" placeholder="请输入新密码（至少6位）" required)
            div.form-group
                label 确认新密码 *
                input.form-control(type="password" name="confirm_password" placeholder="请再次输入新密码" required)
            button.btn.btn-primary(type="submit") 修改密码
            |  
            a.btn.btn-default(href="/profile") 取消
